FROM nvcr.io/nvidia/cuda:12.6.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3-pip python3-dev \
    libgl1-mesa-glx libglfw3-dev libusb-1.0-0-dev \
    libssl-dev libffi-dev cmake git wget unzip ffmpeg \
    x11-apps \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    libglib2.0-0 libsm6 libxrender1 libxext6 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    numpy \
    opencv-python-headless \
    scipy \
    tqdm \
    onnx \
    ecs-logging \
    kornia \
    matplotlib \
    pillow

RUN pip3 install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 \
    --index-url https://download.pytorch.org/whl/cu126

RUN git clone https://github.com/ifzhang/ByteTrack.git /opt/bytetrack && \
    pip3 install --no-cache-dir --no-deps -e /opt/bytetrack && \
    pip3 install --no-cache-dir loguru lap cython_bbox thop

RUN pip3 install --no-cache-dir ultralytics --no-deps && \
    pip3 install --no-cache-dir pyyaml pandas psutil requests

# Install CLIP for YOLO-World open-vocabulary classification.
# We upgrade pip and setuptools first so that PEP 621 (pyproject.toml project name/version)
# metadata is read correctly and registers as 'clip' rather than 'UNKNOWN'.
RUN pip3 install --no-cache-dir --upgrade pip setuptools && \
    pip3 install --no-cache-dir ftfy regex && \
    git clone --depth 1 https://github.com/ultralytics/CLIP.git /opt/clip && \
    pip3 install --no-cache-dir --no-deps /opt/clip

WORKDIR /opt
RUN git clone https://github.com/eclipse-cyclonedds/cyclonedds.git -b releases/0.10.x && \
    cd cyclonedds && mkdir build install && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=../install && \
    cmake --build . --target install

ENV CYCLONEDDS_HOME=/opt/cyclonedds/install
ENV CMAKE_PREFIX_PATH=${CYCLONEDDS_HOME}

RUN pip3 install --no-cache-dir cyclonedds==0.10.2

RUN git clone https://github.com/unitreerobotics/unitree_sdk2_python.git /opt/unitree_sdk2_python && \
    pip3 install --no-cache-dir --no-deps -e /opt/unitree_sdk2_python

ENV PYTHONPATH="/opt/unitree_sdk2_python"

# Nvidia's specific server for TensorRT
RUN pip3 install --no-cache-dir \
    tensorrt==10.6.0 \
    --extra-index-url https://pypi.nvidia.com

# Standard Python server for PyCUDA
RUN pip3 install --no-cache-dir pycuda

# ----------------------
# On-frame HUD (core/hud): real GPU-rendered overlay via arcv (ModernGL vector/
# text batches + HDR bloom). arcv's own pyproject.toml has a packaging bug --
# `packages = ["arcv"]` already bundles arcv/shaders + arcv/resources by
# default, and the extra [tool.hatch.build.targets.wheel.force-include] block
# re-adds the same paths, so a plain `pip install git+https://...` fails
# wheel-building on a duplicate archive entry (confirmed). Strip that
# redundant trailing block before building -- the shader/font assets still
# end up in the wheel via the default packages inclusion (verified: 84 files
# incl. all .frag/.vert/.ttf survive).
# ----------------------
RUN pip3 install --no-cache-dir "moderngl>=5.10" \
    && git clone --depth 1 https://github.com/Anthony-Sin/arcv.git /opt/arcv_build \
    && sed -i '/\[tool\.hatch\.build\.targets\.wheel\.force-include\]/,$d' /opt/arcv_build/pyproject.toml \
    && pip3 install --no-cache-dir --no-deps /opt/arcv_build \
    && rm -rf /opt/arcv_build

WORKDIR /workspace
CMD ["bash"]
