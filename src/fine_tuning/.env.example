# fine_tuning environment template.
#   cp fine_tuning/.env.example fine_tuning/.env   then fill in the blanks.
# .env is gitignored (root .gitignore) and must NEVER be committed.
# Empty values are treated as "unset" and fall back to the defaults below.

# ---- Weights & Biases (experiment tracking) --------------------------------
FT_WANDB=0                       # 1 to enable W&B logging (or pass --wandb)
WANDB_API_KEY=                   # from https://wandb.ai/authorize
WANDB_PROJECT=parkour-depth-finetune
WANDB_ENTITY=                    # team/user; blank = your default entity
WANDB_RUN_NAME=                  # blank = auto-named

# ---- RunPod (pod info / opt-in auto-stop) ----------------------------------
FT_RUNPOD=0                      # 1 to enable RunPod integration (or pass --runpod)
RUNPOD_API_KEY=                  # from RunPod console -> Settings -> API Keys
FT_RUNPOD_AUTOSTOP=0             # 1 to stop THIS pod when training finishes ($ saver)
# RUNPOD_POD_ID is injected by RunPod automatically; do not set it here.

# ---- Credential strictness -------------------------------------------------
FT_REQUIRE_CLOUD=0               # 1 = abort if an ENABLED integration has bad/missing creds

# ---- Paths (blank = use the shipped weights under sim/isaac/assets) ---------
FT_BASE_JIT=                     # base_jit.pt (frozen teacher)
FT_VISION_WEIGHT=                # vision_weight.pt (depth encoder to fine-tune)
FT_CONFIG_JSON=                  # config.json shipped with the weights
FT_OUTPUT_DIR=                   # where checkpoints are written
FT_EPISODES_DIR=                 # directory of sim-emitted episodes (real training)

# ---- Training hyperparameters (optional; CLI flags override) ---------------
FT_DEVICE=auto                   # auto | cuda | cpu
FT_SEED=1
FT_EPOCHS=20
FT_BATCH_SIZE=8
FT_BPTT_WINDOW=24
FT_LR=0.0003
FT_WEIGHT_DECAY=0.0001
FT_GRAD_CLIP=1.0
FT_AMP=1
FT_NUM_WORKERS=4
FT_W_LATENT=1.0
FT_W_YAW=1.0

# ---- Blind-RL stair retrain (fine_tuning/rl/*) -----------------------------
# Retrains the blind rl_sar robot_lab Go2 net (IsaacLab). Separate env from the distill
# stage above. Deploys to sim/models/locomotion/go2_robot_lab_policy.pt.
FT_RL_REPO_URL=https://github.com/fan-ziqi/robot_lab.git
FT_RL_REPO_BRANCH=v2.3.2         # pinned to the working quadruple (see FT_RL_REPO_COMMIT)
FT_RL_REPO_COMMIT=v2.3.2         # pin robot_lab to a known-good tag for reproducibility (findings E, M)
# where robot_lab is cloned (blank = ~/robot_lab). NOTE: keep blank-valued keys
# comment-free on their own line -- an inline comment after a blank value parses AS the value.
FT_RL_REPO_DIR=
# IsaacLab / Isaac Sim provisioning (used by runpod_setup_rl.sh) — the matched quadruple:
#   Isaac Sim 4.5.0 / IsaacLab v2.3.2 / robot_lab v2.3.2 / rsl_rl (via isaaclab.sh --install).
# FT_RL_ISAACSIM_VERSION=4.5.0   # Isaac Sim pip build (pinned quadruple: 4.5.0)
# FT_RL_ISAACLAB_BRANCH=v2.3.2   # IsaacLab clone branch/tag (pinned quadruple: v2.3.2)
# FT_RL_ISAACLAB_DIR=~/IsaacLab  # IsaacLab clone (runpod_setup_rl.sh installs it)
# FT_RL_ISAACLAB_SH=~/IsaacLab/isaaclab.sh   # set to run scripts via 'isaaclab.sh -p'
# FT_RL_PYTHON=                  # python with Isaac Sim (blank = current interpreter)
FT_RL_TASK=RobotLab-Isaac-Velocity-Stairs-O2-Unitree-Go2-v0   # registered by config_patch
FT_RL_EXPTID=o2stair             # rsl_rl --experiment_name (logs/rsl_rl/<exptid>/)
# rsl_rl --run_name (blank = auto)
FT_RL_RUN_NAME=
FT_RL_NUM_ENVS=4096
FT_RL_MAX_ITERS=6000             # budget-friendly full run (~$1-2 on a cheap 4090); raise for more polish
FT_RL_SEED=1
# --smoke shortcut sizing: a fast "does it even run" pass before spending on a full run
FT_RL_SMOKE_ENVS=256
FT_RL_SMOKE_ITERS=300
# override exported policy.pt to deploy (blank = auto-find)
FT_RL_EXPORTED_JIT=

# ---- Blind-RL stair retrain: goal-tuned knobs -----------------------------
FT_RL_LINVELX_MAX=0.6          # forward speed ceiling (m/s); was 0.5. Paired with the ascent reward (finding B)
FT_RL_STEP_H_MIN=0.05          # riser curriculum easy edge (m)
FT_RL_STEP_H_MAX=0.20          # riser curriculum hard edge (m); brackets real 0.15 + residential max 0.198 (finding C)
FT_RL_STEP_W_NOMINAL=0.305     # nominal tread depth (m) — matches the real target stairs
FT_RL_STEP_W_MIN=0.28          # tread-depth randomization band low (m) (finding C)
FT_RL_STEP_W_MAX=0.34          # tread-depth randomization band high (m)
FT_RL_TALL_START_PROP=0.2      # fraction of terrain that is a fixed TALL step, to drill mounting tall starts (finding C)
FT_RL_ORIENT_REWARD=-1.0       # flat_orientation_l2 weight; was -2.5. Reduced so climb pitch isn't over-penalized (finding B)
FT_RL_ASCENT_REWARD=1.0        # NEW vertical-progress reward weight (finding B); 0 disables
FT_RL_ROLL_PENALTY=-2.0        # NEW roll-only anti-tip penalty (finding B); 0 disables
FT_RL_CREST_REWARD=0.5         # NEW reward: level torso on flat -> clean dismount OFF the top landing; 0 disables
FT_RL_COM_JITTER=0.02          # jitter (m) around the payload CoM offset for the CoM domain-randomization event (finding A)
FT_RL_WANDB_PROJECT=blind-rl-stair   # dedicated W&B project for RL runs (finding H: don't co-mingle with the depth project)
# optional comma list of seeds for multi-seed runs (blank = single FT_RL_SEED); select best via eval (finding H/J)
FT_RL_SEEDS=
FT_RL_EVAL_BEFORE_DEPLOY=0     # 1 = score checkpoints in the sim and deploy the best (needs the local Isaac+Docker sim box) (finding D)
